# VS Code crea .env desde esta plantilla la primera vez.
# local = instancia privada con datos de prueba. externa = PostgreSQL existente.
VALES_DB_MODE=local
# Completar los tres campos en modo externa.
# URL de ejemplo: jdbc:postgresql://127.0.0.1:5432/services_vales
VALES_DB_URL=
VALES_DB_USER=
VALES_DB_PASSWORD=

# Clave de las cuentas de demostración al crear una base nueva.
# En modo local se genera en .local/demo.clave si este campo queda vacío.
VALES_DEMO_PASSWORD=

# Origen del backend para npm run dev. Usa el puerto local si se omite.
VALES_DEV_BACKEND_URL=

# HTTPS opcional para escanear desde el celular dentro de la misma red.
VALES_HTTPS_ENABLED=false
VALES_HTTPS_DOMAIN=
VALES_HTTPS_IPV4=
VALES_DUCKDNS_TOKEN=
VALES_HTTPS_ACCEPT_TERMS=false

# demo permite probar 99000001 y 99000002, además del catálogo existente.
# decolecta consulta el proveedor externo. El token se conserva solo en el backend.
VALES_DNI_PROVIDER=demo
VALES_DNI_TOKEN=

# Motor vial OSRM. Puede apuntar a una instancia propia compatible.
VALES_ROUTING_URL=https://router.project-osrm.org
