# VS Code crea .env desde esta plantilla la primera vez.
# local = instancia privada con datos de prueba. externa = PostgreSQL existente.
VALES_DB_MODE=local
# Completar los tres campos en modo externa.
# URL de ejemplo: jdbc:postgresql://127.0.0.1:5432/services_vales
VALES_DB_URL=
VALES_DB_USER=
VALES_DB_PASSWORD=

# HTTPS opcional para escanear desde el celular dentro de la misma red.
VALES_HTTPS_ENABLED=false
VALES_HTTPS_DOMAIN=
VALES_HTTPS_IPV4=
VALES_DUCKDNS_TOKEN=
VALES_HTTPS_ACCEPT_TERMS=false
